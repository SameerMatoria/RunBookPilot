# Copy this file to .env and fill in your keys.
# Any OpenAI-compatible provider works. Later we can point this at Azure AI Foundry.

# Primary: Groq (free key at https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_xxx
LLM_MODEL=openai/gpt-oss-120b

# More Groq models, tried in order when a model's free daily quota runs out (each model has its own).
LLM_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Optional: a preferred model per agent (unset = LLM_MODEL). Example: keep the big model's quota
# for the Author, which writes the code.
# LLM_MODEL_PARSER=qwen/qwen3.8-27b
# LLM_MODEL_REVIEWER=qwen/qwen3.8-27b

# Session signing key and credential encryption key. Generate each once:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                  (SECRET_KEY)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"   (MASTER_KEY)
# BACK UP MASTER_KEY: without it, saved server credentials can't be decrypted.
# If unset, development generates them into data/ automatically (API and worker must share them).
SECRET_KEY=
MASTER_KEY=

# Optional: Microsoft Entra ID sign-in (needs an app registration, see README)
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_DEFAULT_ROLES=submitter

# Optional backup: Google Gemini (free key at https://aistudio.google.com/apikey)
# Used automatically if Groq fails or hits its rate limit.
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-flash-latest
