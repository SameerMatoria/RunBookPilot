#!/usr/bin/env bash
# Sandbox stand-in for systemctl (containers have no systemd).
# Supports two services: nginx (port 80) and myapp (port 8080, its own nginx instance).
quiet=0
args=()
for a in "$@"; do
  case "$a" in
    -q|--quiet) quiet=1 ;;
    --no-pager|--full|-l) ;;
    *) args+=("$a") ;;
  esac
done
cmd="${args[0]:-}"
svc="${args[1]:-}"
svc="${svc%.service}"

say() { [ "$quiet" = 1 ] || echo -e "$@"; }

case "$svc" in
  nginx) pidfile=/run/nginx.pid; ctl=(nginx); desc="A high performance web server" ;;
  myapp) pidfile=/run/myapp.pid; ctl=(nginx -c /etc/myapp/nginx.conf); desc="MyApp application service" ;;
  *)
    if [ "$cmd" = "list-units" ] || [ "$cmd" = "--failed" ]; then
      echo "nginx.service loaded active running"; echo "myapp.service loaded active running"; exit 0
    fi
    echo "Unit ${svc}.service could not be found." >&2
    exit 4 ;;
esac

running() { [ -s "$pidfile" ] && [ -d "/proc/$(cat "$pidfile")" ]; }  # works for non-root users too, like real systemctl
wait_stopped() { for _ in $(seq 1 50); do running || return 0; sleep 0.1; done; }
start() { running || "${ctl[@]}"; }
stop() { if running; then "${ctl[@]}" -s quit; wait_stopped; fi; rm -f "$pidfile"; }

case "$cmd" in
  is-active)
    if running; then say active; exit 0; else say inactive; exit 3; fi ;;
  status)
    if running; then
      say "● ${svc}.service - ${desc}\n     Active: active (running)\n   Main PID: $(cat "$pidfile")"; exit 0
    else
      say "○ ${svc}.service - ${desc}\n     Active: inactive (dead)"; exit 3
    fi ;;
  start)    start ;;
  stop)     stop ;;
  restart)  stop; start ;;
  reload)   if running; then "${ctl[@]}" -s reload; else echo "${svc} is not running" >&2; exit 1; fi ;;
  is-enabled) say enabled ;;
  enable|disable|daemon-reload) ;;
  *) echo "systemctl (sandbox): unsupported command '$cmd'" >&2; exit 1 ;;
esac
